# Django 설정
SECRET_KEY=your-django-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.dev

# 데이터베이스 설정
DB_NAME=capstone
DB_USER=sa
DB_PASSWORD=1234
DB_HOST=mysqldb
DB_PORT=3306

# GCS (Google Cloud Storage) 설정
GCS_BUCKET_NAME=your-gcs-bucket-name
# GCS 인증을 위한 서비스 계정 키 파일 경로
GOOGLE_APPLICATION_CREDENTIALS=/app/path/to/service-account-key.json

# Celery / RabbitMQ 설정
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Firebase 설정 (FCM Push Notification)
# Firebase Admin SDK는 GOOGLE_APPLICATION_CREDENTIALS를 사용합니다
# 또는 별도의 Firebase 서비스 계정 키 경로를 지정할 수 있습니다
# FIREBASE_SERVICE_ACCOUNT_KEY=/app/path/to/firebase-service-account.json

# CORS 설정
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 디버그 모드 (프로덕션에서는 False)
DEBUG=True
